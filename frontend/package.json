{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "browserslist": [
    "last 2 versions and > 0.5% and not dead"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "type-coverage": "type-coverage --project tsconfig.app.json --at-least 99",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dep:check": "dependency-cruiser -c .dependency-cruiser.cjs -T err src"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.103.1",
    "@vercel/blob": "^2.8.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.14.5",
    "jiti": "^2.7.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.8",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "type-coverage": "^2.30.4",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  }
}
