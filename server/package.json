{
  "name": "book-catalog-mock-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "coverage": "node --import tsx --experimental-test-coverage --test tests/*.test.ts",
    "type-coverage": "type-coverage --project tsconfig.json --at-least 99",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.13.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.10.0",
    "jiti": "^2.7.0",
    "tsx": "^4.20.5",
    "type-coverage": "^2.30.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.1"
  }
}
